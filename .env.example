# Copier en .env.local (en local) ou saisir dans Vercel : Settings > Environment Variables.
# Les deux valeurs viennent de Supabase : Project Settings > API Keys (clé « publishable »)
# et Project Settings > Data API (Project URL). Elles sont publiques : aucune clé secrète ici.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Facultatif : « files » force la lecture du contenu dans le dossier content/, même si la base en contient.
CONTENT_SOURCE=
