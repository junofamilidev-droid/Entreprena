# Copier en .env.local (en local) ou saisir dans Vercel : Settings > Environment Variables.
# Les deux valeurs viennent de Supabase : Project Settings > API Keys (clé « publishable »)
# et Project Settings > Data API (Project URL). Elles sont publiques : aucune clé secrète ici.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Facultatif : « files » force la lecture du contenu dans le dossier content/, même si la base en contient.
CONTENT_SOURCE=
# Clé SECRÈTE Supabase (Project Settings > API Keys > « secret »), pour le diagnostic.
# À saisir UNIQUEMENT dans Vercel (jamais dans le code ni dans un fichier envoyé sur GitHub).
SUPABASE_SECRET_KEY=

# Paiement Stripe (à régler dans Vercel, jamais dans le code). Sans clé, le site propose « Être prévenu ».
# Mode test : clé « sk_test_… », à mettre seulement sur l'environnement Preview tant que la vente n'est pas ouverte.
STRIPE_SECRET_KEY=
# Secret du point d'arrivée des notifications Stripe (/api/stripe/webhook), « whsec_… ». Facultatif en test.
STRIPE_WEBHOOK_SECRET=

# Emails automatiques (Resend, après l'achat du nom de domaine). Sans ces deux valeurs, aucun email ne part.
RESEND_API_KEY=
# Expéditeur, sur votre domaine vérifié dans Resend : « Entreprena <bonjour@votre-domaine.fr> »
EMAIL_EXPEDITEUR=
# Adresse qui reçoit les réponses (avis des testeurs, questions) : facultatif
EMAIL_REPONSE=
# Adresse du site, pour les liens des emails : « https://votre-domaine.fr »
SITE_URL=
# Secret de l'envoi quotidien des conseils (Vercel l'utilise tout seul pour lancer /api/cron/emails)
CRON_SECRET=
